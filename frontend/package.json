{
  "name": "tools-switcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test:ui": "node tests/ui.mjs",
    "format": "prettier --write src tests index.html vite.config.ts package.json",
    "format:check": "prettier --check src tests index.html vite.config.ts package.json"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.34",
    "react": "18.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
